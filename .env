# WebSocket configuration (WS / WSS)
WS_PROTOCOL=ws
WS_HOST=10.180.12.100
WS_PORT=25001
WS_PATH=/graphql
WS_URL=${WS_PROTOCOL}://${WS_HOST}:${WS_PORT}${WS_PATH}

# HTTP configuration (HTTP / HTTPS)
HTTP_PROTOCOL=http
HTTP_HOST=10.180.12.100
HTTP_PORT=25001
HTTP_BASE_PATH=/graphql
HTTP_URL=${HTTP_PROTOCOL}://${HTTP_HOST}:${HTTP_PORT}${HTTP_BASE_PATH}