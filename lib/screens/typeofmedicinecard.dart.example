                                   fontWeight: FontWeight.bold,
                                 ),
                               ),
                               SizedBox(height: 8.h),
                               Row(
                                 children: [
                                   Expanded(
                                     child: buildOption(
                                       type: MedicineType.capsule,
                                       assetName:
